{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshi.local/mechanistic/analysis-spec.schema.json",
  "title": "Frozen empirical mechanistic analysis specification",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_kind",
    "status",
    "alpha",
    "bootstrap_replicates",
    "bootstrap_seed",
    "cluster_key",
    "hypotheses",
    "config_sha256",
    "template_sha256",
    "expected_cells_uri",
    "expected_cells_file_sha256",
    "expected_cells_sha256",
    "expected_cell_count",
    "source_plans_sha256",
    "selection_bindings",
    "analysis_spec_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_kind": {"const": "empirical_preregistered"},
    "status": {"const": "frozen_before_confirmation"},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "bootstrap_replicates": {"type": "integer", "minimum": 100},
    "bootstrap_seed": {"type": "integer"},
    "cluster_key": {"const": "scenario_id"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "expected_cells_uri": {"$ref": "#/$defs/relativeUri"},
    "expected_cells_file_sha256": {"$ref": "#/$defs/sha256"},
    "expected_cells_sha256": {"$ref": "#/$defs/sha256"},
    "expected_cell_count": {"type": "integer", "minimum": 1},
    "source_plans_sha256": {"$ref": "#/$defs/sha256"},
    "selection_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "sha256", "selection_sha256"],
        "properties": {
          "uri": {"$ref": "#/$defs/relativeUri"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "selection_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "analysis_spec_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativeUri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "selectorValue": {
      "anyOf": [
        {"type": ["string", "integer", "number", "boolean", "null"]},
        {
          "type": "object",
          "required": ["in"],
          "properties": {
            "in": {
              "type": "array",
              "minItems": 1,
              "items": {"type": ["string", "integer", "number", "boolean", "null"]}
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "term": {
      "type": "object",
      "required": ["selector", "metric", "weight"],
      "properties": {
        "selector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/selectorValue"}
        },
        "metric": {"enum": ["baseline_M", "patched_M", "delta_M"]},
        "weight": {"type": "number"}
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": ["id", "family", "direction", "sesoi", "terms"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "direction": {"enum": ["positive", "negative"]},
        "sesoi": {"type": "number", "minimum": 0},
        "terms": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/term"}
        }
      },
      "additionalProperties": false
    }
  }
}
