{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshi.local/mechanistic/patch-result.schema.json",
  "type": "object",
  "required": ["schema_version", "cell_id", "run_identity_sha256", "donor_trial_id", "recipient_trial_id", "component", "layer", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "cell_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["completed", "failed"]},
    "delta_M": {"type": "number"}
  },
  "additionalProperties": true
}
