{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshi.local/mechanistic/expected-cells.schema.json",
  "title": "Frozen exact mechanistic result-cell universe",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "cell_count",
    "cell_ids",
    "cell_ids_sha256",
    "cells",
    "source_plans",
    "source_plans_sha256",
    "pristine_at_freeze",
    "expected_cells_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "frozen_before_confirmation"},
    "cell_count": {"type": "integer", "minimum": 1},
    "cell_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "cell_ids_sha256": {"$ref": "#/$defs/sha256"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "source_plans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourcePlan"}
    },
    "source_plans_sha256": {"$ref": "#/$defs/sha256"},
    "pristine_at_freeze": {"const": true},
    "expected_cells_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativeUri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "cell": {
      "type": "object",
      "required": [
        "cell_id", "role", "donor_arm", "relation", "component", "layer",
        "head", "anchor", "donor_trial_id", "recipient_trial_id"
      ],
      "properties": {
        "cell_id": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1},
        "donor_arm": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "layer": {"type": "integer", "minimum": 0},
        "head": {"type": ["integer", "null"], "minimum": 0},
        "anchor": {"type": "string", "minLength": 1},
        "donor_trial_id": {"type": "string", "minLength": 1},
        "recipient_trial_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sourcePlan": {
      "type": "object",
      "required": [
        "planned_cells_uri", "planned_cells_file_sha256",
        "planned_cells_value_sha256", "scan_plan_uri", "scan_plan_sha256",
        "result_uri", "role", "kind", "cell_count", "selection_binding"
      ],
      "properties": {
        "planned_cells_uri": {"$ref": "#/$defs/relativeUri"},
        "planned_cells_file_sha256": {"$ref": "#/$defs/sha256"},
        "planned_cells_value_sha256": {"$ref": "#/$defs/sha256"},
        "scan_plan_uri": {"$ref": "#/$defs/relativeUri"},
        "scan_plan_sha256": {"$ref": "#/$defs/sha256"},
        "result_uri": {"$ref": "#/$defs/relativeUri"},
        "role": {"type": "string", "minLength": 1},
        "kind": {"type": ["string", "null"]},
        "cell_count": {"type": "integer", "minimum": 1},
        "selection_binding": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "additionalProperties": false
    }
  }
}
